+    /// Decrypt a VC control-channel packet. Direct U1 datagrams omit the
+    /// participant identifier, so try each participant whose AVC UUID and MKM
+    /// have completed before the later IDS join notification.
+    pub async fn decrypt_control_message(
+        &self,
+        payload: &[u8],
+        local_session_id: &str,
+        participant_hint: Option<u64>,
+        peer_session_id_hint: Option<&str>,
+    ) -> Result<(u64, Vec<u8>), PushError> {
+        let mut state = self.state.lock().await;
+        for (participant, participant_state) in &mut state.states {
+            if participant_hint.is_some_and(|hint| hint != *participant) {
+                continue;
+            }
+            let Some(peer_session_id) = participant_state.avc_uuid.clone()
+                .or_else(|| peer_session_id_hint.map(ToOwned::to_owned)) else { continue };
+            for mkm in &participant_state.mkm {
+                let key = mkm.get_control(&peer_session_id, local_session_id);
+                if let Ok(plaintext) = key.decrypt(payload) {
+                    participant_state.avc_uuid.get_or_insert(peer_session_id);
+                    return Ok((*participant, plaintext));
+                }
+            }
+        }
+        Err(PushError::BadMsg)
+    }
+
+    pub async fn control_context_summary(&self) -> (usize, usize, usize) {
+        let state = self.state.lock().await;
+        (
+            state.states.len(),
+            state.states.values().filter(|peer| peer.avc_uuid.is_some()).count(),
+            state.states.values().map(|peer| peer.mkm.len()).sum(),
+        )
+    }
+
+    /// Encrypt and route one VC control-channel protobuf to a participant,
+    /// preferring the selected direct U1 path and falling back to the AVC pod.
+    pub async fn send_control_message(
+        &self,
+        participant: u64,
+        local_session_id: &str,
+        plaintext: &[u8],
+    ) -> Result<(), PushError> {
+        let (encrypted, direct_socket, direct_peer, avc_pod) = {
+            let mut state = self.state.lock().await;
+            let peer_session_id = state.states.get(&participant)
+                .and_then(|peer| peer.avc_uuid.clone())
+                .ok_or(PushError::BadMsg)?;
+            let counter = state.control_send_counters.entry(participant).or_default();
+            *counter = counter.wrapping_add(1);
+            let counter = *counter;
+            let key = state.my_mkm.get_control(local_session_id, &peer_session_id);
+            (
+                key.encrypt(plaintext, counter)?,
+                state.direct_socket.clone(),
+                state.direct_peer,
+                state.avc_pod.clone().ok_or(PushError::NotConnected)?,
+            )
+        };
+        let mut framed_control = Vec::with_capacity(encrypted.len() + 1);
+        framed_control.push(0x40);
+        framed_control.extend_from_slice(&encrypted);
+        if let (Some(socket), Some(peer)) = (direct_socket, direct_peer) {
+            socket.send_to(&framed_control, peer).await.map_err(|_| PushError::NotConnected)?;
+        } else {
+            let framed = GlobalPacket {
+                participant: Some(participant),
+                link: LinkType::Pod,
+                data: framed_control,
+            }.to_qr_raw();
+            avc_pod.send_datagram(framed.into()).map_err(|_| PushError::NotConnected)?;
+        }
+        Ok(())
+    }
