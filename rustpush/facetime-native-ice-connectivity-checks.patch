+/// Flatten a peer's ConnectionData into socket addresses.
+///
+/// Each entry in `candidates` points at an entry in `ip_candidates` by index
+/// and carries the port, so the two lists have to be recombined. Unknown or
+/// IPv6-only entries are skipped rather than failing the whole set.
+/// How long to keep retrying connectivity checks, and how often. The answering
+/// responder abandons a call after 15s, so the window outlasts that while the
+/// interval stays well inside a normal ICE check pace.
+const CONNECTIVITY_CHECK_WINDOW_SECS: u64 = 30;
+const CONNECTIVITY_CHECK_INTERVAL_MS: u64 = 400;
+
+fn peer_candidate_addresses(connection_data: &ConnData) -> Vec<SocketAddr> {
+    connection_data
+        .candidates
+        .iter()
+        .filter_map(|candidate| {
+            let ip_candidate = connection_data
+                .ip_candidates
+                .get(candidate.ip_idx as usize)?;
+            let octets = ip_candidate.ipv4_addr?;
+            Some(SocketAddr::V4(SocketAddrV4::new(
+                std::net::Ipv4Addr::from(octets),
+                candidate.some_addr_meta,
+            )))
+        })
+        .collect()
+}
