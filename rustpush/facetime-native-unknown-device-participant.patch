+    /// Bind the VC session UUID learned from an authenticated IDS envelope to
+    /// the exact QuickRelay participant represented by that envelope's device
+    /// token. This call-local association must not depend on message history.
+    pub async fn bind_participant_session_id(
+        &self,
+        participant_id: u64,
+        peer_session_id: &str,
+    ) -> Result<(), PushError> {
+        let mut state = self.state.lock().await;
+        if !state.configuration.allocations.iter()
+            .any(|allocation| allocation.id == participant_id as i64)
+        {
+            return Err(PushError::BadMsg);
+        }
+        state.states.entry(participant_id).or_default().avc_uuid =
+            Some(peer_session_id.to_string());
+        Ok(())
+    }
