+/// Summarize FaceTime's audio bundle/RED framing without logging encoded audio.
+/// Each audio block is a sequence of one-byte-length-prefixed codec frames.
+fn describe_facetime_audio_payload(payload_type: u8, payload: &[u8]) -> String {
+    fn frame_sizes(block: &[u8]) -> (Vec<usize>, bool) {
+        let mut sizes = Vec::new();
+        let mut cursor = 0usize;
+        while cursor < block.len() {
+            let size = block[cursor] as usize;
+            cursor += 1;
+            let Some(end) = cursor.checked_add(size).filter(|end| *end <= block.len()) else {
+                return (sizes, false);
+            };
+            sizes.push(size);
+            cursor = end;
+        }
+        (sizes, true)
+    }
+
+    if payload_type != 20 {
+        let (sizes, complete) = frame_sizes(payload);
+        return format!("pt={payload_type} frames={sizes:?} complete={complete}");
+    }
+
+    // RFC 2198: zero or more four-byte redundant headers followed by one
+    // one-byte primary header, then the blocks in that same order.
+    let mut cursor = 0usize;
+    let mut blocks: Vec<(u8, Option<usize>)> = Vec::new();
+    loop {
+        let Some(first) = payload.get(cursor).copied() else {
+            return "pt=20 invalid=missing-red-header".to_string();
+        };
+        cursor += 1;
+        let pt = first & 0x7f;
+        if first & 0x80 == 0 {
+            blocks.push((pt, None));
+            break;
+        }
+        if cursor + 3 > payload.len() {
+            return "pt=20 invalid=truncated-red-header".to_string();
+        }
+        let block_len = (((payload[cursor + 1] & 0x03) as usize) << 8)
+            | payload[cursor + 2] as usize;
+        cursor += 3;
+        blocks.push((pt, Some(block_len)));
+    }
+
+    let mut descriptions = Vec::with_capacity(blocks.len());
+    for (pt, declared_len) in blocks {
+        let available = payload.len().saturating_sub(cursor);
+        let block_len = declared_len.unwrap_or(available);
+        if block_len > available {
+            descriptions.push(format!("pt={pt} bytes={block_len} invalid=truncated"));
+            break;
+        }
+        let block = &payload[cursor..cursor + block_len];
+        let (sizes, complete) = frame_sizes(block);
+        descriptions.push(format!(
+            "pt={pt} bytes={block_len} frames={sizes:?} complete={complete}"
+        ));
+        cursor += block_len;
+    }
+    format!("pt=20 blocks=[{}] trailing={}", descriptions.join(", "), payload.len().saturating_sub(cursor))
+}
