+        let encrypted = response
+            .get("et")
+            .and_then(Value::as_data)
+            .ok_or(Error::Parse)?;
+        if encrypted.len() < 3 + 16 + 16 || &encrypted[..3] != b"XYZ" {
+            return Err(Error::Parse);
+        }
