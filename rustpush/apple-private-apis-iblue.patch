+        let auth_token = spd
+            .get("GsIdmsToken")
+            .and_then(Value::as_string)
+            .ok_or(Error::Parse)?
+            .to_string();
+        let session_key = spd
+            .get("sk")
+            .and_then(Value::as_data)
+            .ok_or(Error::Parse)?
+            .to_vec();
+        let cookie = spd
+            .get("c")
+            .and_then(Value::as_data)
+            .ok_or(Error::Parse)?
+            .to_vec();
+
+        let valid_anisette = self.get_anisette().await?;
+        let checksum = Self::create_checksum(&session_key, &dsid, app_name);
+
+        let mut gsa_headers = HeaderMap::new();
+        gsa_headers.insert(
+            "Content-Type",
+            HeaderValue::from_static("text/x-xml-plist"),
+        );
+        gsa_headers.insert("Accept", HeaderValue::from_static("*/*"));
+        gsa_headers.extend(
+            valid_anisette
+                .get_app_token_headers()
+                .into_iter()
+                .map(|(key, value)| {
+                    (
+                        HeaderName::from_str(&key).unwrap(),
+                        HeaderValue::from_str(&value).unwrap(),
+                    )
+                }),
+        );
+
+        let packet = AuthTokenRequest {
+            header: RequestHeader {
+                version: "1.0.1".to_string(),
+            },
+            request: AuthTokenRequestBody {
+                app: vec![app_name.to_string()],
+                c: Value::Data(cookie),
+                cpd: valid_anisette.get_app_token_cpd(),
+                operation: "apptokens".to_string(),
+                t: auth_token,
+                u: dsid,
+                checksum: Value::Data(checksum),
+            },
+        };
+
+        let mut body = Vec::new();
+        plist::to_writer_xml(&mut body, &packet)?;
+        let response = parse_response(
+            self.client
+                .post(GSA_ENDPOINT)
+                .headers(gsa_headers)
+                .body(body)
+                .send()
