+    fn roll(&self, group_id: &str) -> Option<Self> {
+        let mut short = MkiShortFormat::parse(&self.mki)?;
+        short.ratchet_index = short.ratchet_index.checked_add(1)?;
+        if short.ratchet_index > 15 {
+            return None;
+        }
+
+        let mut padded_mks = self.mks.clone();
+        padded_mks.resize(32, 0);
+        let mut next_salt = vec![0u8; self.mks.len()];
+        Hkdf::<Sha256>::from_prk(&padded_mks)
+            .ok()?
+            .expand(group_id.as_bytes(), &mut next_salt)
+            .ok()?;
+        let mut next_key = vec![0u8; self.mkm.len()];
+        Hkdf::<Sha256>::new(None, &self.mkm)
+            .expand(group_id.as_bytes(), &mut next_key)
+            .ok()?;
+        Some(Self {
+            mks: next_salt,
+            mkm: next_key,
+            mki: short.serialize().to_vec(),
+            mkgc: self.mkgc.saturating_add(1),
+            ..self.clone()
+        })
+    }
+
+    fn current_and_next(&self, group_id: &str, count: usize) -> Vec<Self> {
+        let mut result = Vec::with_capacity(count);
+        let mut current = Some(self.clone());
+        while result.len() < count {
+            let Some(material) = current else { break };
+            current = material.roll(group_id);
+            result.push(material);
+        }
+        result
+    }
