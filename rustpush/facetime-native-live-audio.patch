+struct NativeAudioSender {
+    context: Context,
+    header_template: rtc_rtp::Header,
+    peer_participant: Option<u64>,
+    avc_pod: Pod,
+    direct_socket: Option<Arc<UdpSocket>>,
+    direct_peer: Option<SocketAddr>,
+    ssrc: u32,
+    payload_type: u8,
+    samples_per_packet: u32,
+    packet_duration_ms: u64,
+    sequence_number: u16,
+    timestamp: u32,
+    packet_index: u64,
+    started: tokio::time::Instant,
+}
+
+impl NativeAudioSender {
+    async fn send_packet(&mut self, payload: Vec<u8>) -> Result<usize, PushError> {
+        let payload_len = payload.len();
+        if self.payload_type == 104 && payload_len > u8::MAX as usize {
+            warn!(
+                "FaceTime AAC-ELD access unit is too large for Apple audio framing: {} bytes",
+                payload_len,
+            );
+            return Err(PushError::BadMsg);
+        }
+
+        // PT104 carries one-byte-length-prefixed AAC-ELD access units. PT108
+        // carries one complete EVS payload (including Apple's three-frame
+        // bundle produced by VCAudioPayload) without an outer prefix.
+        let framed_payload = if self.payload_type == 104 {
+            let mut framed = Vec::with_capacity(payload_len + 1);
+            framed.push(payload_len as u8);
+            framed.extend_from_slice(&payload);
+            framed
+        } else if self.payload_type == 108 {
+            payload
+        } else {
+            return Err(PushError::BadMsg);
+        };
+
+        let current_send = ((self.timestamp as u64 + 52_676) * 16 / 375) as u16;
+        let mut audio_control = vec![0u8; 20];
+        audio_control[8..10].copy_from_slice(&current_send.to_be_bytes());
+        self.header_template.version = 2;
+        self.header_template.padding = false;
+        self.header_template.extension = true;
+        self.header_template.marker = self.packet_index == 0;
+        self.header_template.payload_type = self.payload_type;
+        self.header_template.sequence_number = self.sequence_number;
+        self.header_template.timestamp = self.timestamp;
+        self.header_template.ssrc = self.ssrc;
+        self.header_template.csrc.clear();
+        self.header_template.extension_profile = 0x8d00;
+        self.header_template.extensions = vec![rtc_rtp::header::Extension {
+            id: 0,
+            payload: audio_control.into(),
+        }];
+        self.header_template.extensions_padding = 0;
+        let packet = rtc_rtp::Packet {
+            header: self.header_template.clone(),
+            payload: framed_payload.into(),
+        };
+        let plaintext = packet.marshal().map_err(|_| PushError::BadMsg)?;
+        let encrypted = self
+            .context
+            .encrypt_rtp(&plaintext)
+            .map_err(|_| PushError::BadMsg)?;
+        if let (Some(socket), Some(peer)) = (&self.direct_socket, self.direct_peer) {
+            socket
+                .send_to(&encrypted, peer)
+                .await
+                .map_err(|_| PushError::NotConnected)?;
+        } else {
+            let framed = GlobalPacket {
+                participant: self.peer_participant,
+                link: LinkType::Pod,
+                data: encrypted.to_vec(),
+            }
+            .to_qr_raw();
+            self.avc_pod
+                .send_datagram(framed.into())
+                .map_err(|_| PushError::NotConnected)?;
+        }
+
+        self.sequence_number = self.sequence_number.wrapping_add(1);
+        self.timestamp = self.timestamp.wrapping_add(self.samples_per_packet);
+        self.packet_index = self.packet_index.saturating_add(1);
+        let deadline = self.started
+            + std::time::Duration::from_millis(
+                self.packet_index.saturating_mul(self.packet_duration_ms),
+            );
+        tokio::time::sleep_until(deadline).await;
+        Ok(payload_len)
+    }
+}
