 const APPLE_RTP_SHORT_MKI: [u8; 2] = [0x00, 0x10];
 
+struct MkiShortFormat {
+    roll_index: u16,
+    ratchet_index: u8,
+    participant_id: u64,
+}
+
+impl MkiShortFormat {
+    fn parse(data: &[u8]) -> Option<Self> {
+        if data.len() != 16 || data[6] != 0 || data[11..] != [0; 5] {
+            return None;
+        }
+        let initial = u16::from_be_bytes(data[..2].try_into().ok()?);
+        let top_bits = u32::from_be_bytes(data[2..6].try_into().ok()?);
+        let bottom_bits = u32::from_be_bytes(data[7..11].try_into().ok()?);
+        Some(Self {
+            roll_index: initial >> 4,
+            ratchet_index: initial as u8 & 0x0f,
+            participant_id: ((top_bits as u64) << 32) | bottom_bits as u64,
+        })
+    }
+
+    fn serialize(&self) -> [u8; 16] {
+        let mut result = [0u8; 16];
+        let initial = (self.roll_index << 4) | self.ratchet_index as u16;
+        result[..2].copy_from_slice(&initial.to_be_bytes());
+        result[2..6].copy_from_slice(&((self.participant_id >> 32) as u32).to_be_bytes());
+        result[7..11].copy_from_slice(&(self.participant_id as u32).to_be_bytes());
+        result
+    }
+}
