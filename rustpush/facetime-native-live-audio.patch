+    /// Send a bounded stream of already-encoded audio access units while
+    /// retaining one SRTP context and monotonically advancing RTP state.
+    pub async fn send_native_audio_stream(
+        &self,
+        group_id: &str,
+        packets: tokio::sync::mpsc::Receiver<Vec<u8>>,
+        progress: tokio::sync::mpsc::UnboundedSender<usize>,
+        payload_type: u8,
+        samples_per_packet: u32,
+        packet_duration_ms: u64,
+    ) -> Result<(), PushError> {
+        let (connection, audio_ssrc) = {
+            let state = self.state.read().await;
+            let session = state.sessions.get(group_id).ok_or(PushError::BadMsg)?;
+            let connection = session.connection.clone().ok_or(PushError::BadMsg)?;
+            let audio_ssrc = session.av_config.as_ref().ok_or(PushError::BadMsg)?.audio_ssrc;
+            (connection, audio_ssrc)
+        };
+        if !connection.link.is_bootstrapped().await {
+            return Err(PushError::NotConnected);
+        }
+        connection
+            .link
+            .send_audio_stream(
+                audio_ssrc,
+                packets,
+                progress,
+                payload_type,
+                samples_per_packet,
+                packet_duration_ms,
+            )
+            .await
+    }
