+
+    pub async fn send_video_stream(
+        &self,
+        ssrc: u32,
+        mut frames: tokio::sync::mpsc::Receiver<Vec<u8>>,
+        image_description: Vec<u8>,
+        progress: tokio::sync::mpsc::UnboundedSender<(u64, u64)>,
+        frame_duration_ms: u64,
+    ) -> Result<(), PushError> {
+        if image_description.is_empty() {
+            return Err(PushError::BadMsg);
+        }
+        let mut sender = self
+            .create_native_video_sender(ssrc, frame_duration_ms)
+            .await?;
+        let mut first_frame = true;
+        while let Some(frame) = frames.recv().await {
+            let description = first_frame.then_some(image_description.as_slice());
+            let (packets, payload_bytes) = sender.send_frame(frame, description).await?;
+            first_frame = false;
+            let _ = progress.send((packets, payload_bytes));
+        }
+        Ok(())
     }
 
