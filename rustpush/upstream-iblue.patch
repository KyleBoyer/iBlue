+async fn connect_apns_socket(
+    connector: &TlsConnector,
+    domain: &str,
+    hostname: &str,
+) -> Result<TlsStream<TcpStream>, PushError> {
+    let mut last_error = None;
+
+    for (index, port) in APNS_PORTS.iter().copied().enumerate() {
+        // Apple documents TCP 443 as the device fallback when 5223 is
+        // unavailable. Bound each attempt independently so a blackholed 5223
+        // path cannot consume the complete socket-open budget before 443.
+        let attempt = tokio::time::timeout(APNS_PORT_ATTEMPT_TIMEOUT, async {
+            // std::net::ToSocketAddrs performs blocking DNS on the Tokio worker.
+            // Resolve asynchronously, and let Tokio try every returned address
+            // instead of coupling APNs availability to the first DNS result.
+            let addresses: Vec<_> = lookup_host((domain, port)).await?.collect();
+            if addresses.is_empty() {
+                return Err(std::io::Error::new(
+                    std::io::ErrorKind::NotFound,
+                    "APNs host resolved to no addresses",
+                ).into());
+            }
+
+            let socket = TcpStream::connect(addresses.as_slice()).await?;
+            let dnsname = ServerName::try_from(hostname.to_owned()).map_err(|err| {
+                std::io::Error::new(
+                    std::io::ErrorKind::InvalidInput,
+                    format!("invalid APNs TLS hostname: {err}"),
+                )
+            })?;
+            let stream = connector.connect(dnsname, socket).await?;
+            Ok::<TlsStream<TcpStream>, PushError>(stream)
+        }).await;
+
+        match attempt {
+            Ok(Ok(stream)) => {
+                if index > 0 {
+                    info!("Connected to APNs on fallback TCP port {port}");
+                }
+                return Ok(stream);
+            }
+            Ok(Err(err)) => last_error = Some(err),
+            Err(_) => {
+                last_error = Some(std::io::Error::new(
+                    std::io::ErrorKind::TimedOut,
+                    format!(
+                        "APNs TCP port {port} attempt timed out after {} seconds",
+                        APNS_PORT_ATTEMPT_TIMEOUT.as_secs()
+                    ),
+                ).into());
+            }
+        }
+
+        if index + 1 < APNS_PORTS.len() {
+            info!("APNs TCP port {port} unavailable; trying fallback port");
+        }
+    }
+
+    Err(last_error.unwrap_or_else(|| {
+        std::io::Error::new(
+            std::io::ErrorKind::NotConnected,
+            "no APNs connection ports configured",
+        ).into()
+    }))
+}

