+fn plist_shape(value: &Value) -> String {
+    match value {
+        Value::Dictionary(values) => format!(
+            "dict{{{}}}",
+            values.iter().map(|(key, value)| format!("{key}:{}", plist_shape(value))).collect::<Vec<_>>().join(",")
+        ),
+        Value::Array(values) => format!(
+            "array({})[{}]",
+            values.len(),
+            values.iter().take(3).map(plist_shape).collect::<Vec<_>>().join(",")
+        ),
+        Value::Data(value) => format!("data({})", value.len()),
+        Value::String(value) => format!("string({})", value.len()),
+        Value::Boolean(_) => "bool".to_string(),
+        Value::Integer(_) => "integer".to_string(),
+        Value::Real(_) => "real".to_string(),
+        Value::Date(_) => "date".to_string(),
+        Value::Uid(_) => "uid".to_string(),
+        _ => "other".to_string(),
+    }
+}
+
+fn json_shape(value: &serde_json::Value) -> String {
+    match value {
+        serde_json::Value::Object(values) => format!(
+            "object{{{}}}",
+            values
+                .iter()
+                .map(|(key, value)| format!("{key}:{}", json_shape(value)))
+                .collect::<Vec<_>>()
+                .join(",")
+        ),
+        serde_json::Value::Array(values) => format!(
+            "array({})[{}]",
+            values.len(),
+            values
+                .iter()
+                .take(2)
+                .map(json_shape)
+                .collect::<Vec<_>>()
+                .join(",")
+        ),
+        serde_json::Value::String(value) => format!("string({})", value.len()),
+        serde_json::Value::Number(_) => "number".to_string(),
+        serde_json::Value::Bool(_) => "bool".to_string(),
+        serde_json::Value::Null => "null".to_string(),
+    }
+}
