+    let find_my_identifier = values
+        .get("entityIdentifier")
+        .or_else(|| values.get("findMyIdentifier"))
+        .and_then(plist_wrapped_string)?;
+    let index = values.get("index").and_then(plist_wrapped_integer)?;
+    let private_key = values.get("privateKey").and_then(plist_wrapped_data)?;
+    let advertised_location_id = values
+        .get("hashedAdvertisement")
+        .or_else(|| values.get("advertisedLocationId"))
+        .and_then(plist_wrapped_data)?;
+
+    Some(DecodedSecureFriendKeyUpdate {
+        find_my_identifier,
+        index,
+        private_key,
+        advertised_location_id,
+    })
+}
+
+fn decode_secure_friend_key_updates(value: &Value) -> Vec<DecodedSecureFriendKeyUpdate> {
+    match value {
+        Value::Array(values) => values.iter().filter_map(decode_secure_friend_key_update).collect(),
