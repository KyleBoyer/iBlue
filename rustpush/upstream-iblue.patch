+fn decrypt_secure_friend_custom_ecies(
+    private_key: &[u8],
+    encrypted_data: &[u8],
+) -> Result<Vec<u8>, PushError> {
+    if private_key.len() != 85 || encrypted_data.len() < 57 + 16 {
+        return Err(PushError::BadMsg);
+    }
+    let (public_key, private_scalar) = private_key.split_at(57);
+    let group = EcGroup::from_curve_name(Nid::SECP224R1)?;
+    let mut context = BigNumContext::new()?;
+    let own_public = EcPoint::from_bytes(&group, public_key, &mut context)?;
+    let own_private = BigNum::from_slice(private_scalar)?;
+    let own_key = EcKey::from_private_components(&group, &own_private, &own_public)?;
+
+    let peer_public = EcPoint::from_bytes(&group, &encrypted_data[..57], &mut context)?;
+    let peer_key = EcKey::from_public_key(&group, &peer_public)?;
+    let own_pkey = PKey::from_ec_key(own_key)?;
+    let peer_pkey = PKey::from_ec_key(peer_key)?;
+    let mut deriver = Deriver::new(&own_pkey)?;
+    deriver.set_peer(&peer_pkey)?;
+    let secret = deriver.derive_to_vec()?;
+    let symmetric = sha256(&[
+        secret.as_slice(),
+        &[0x00, 0x00, 0x00, 0x01],
+        &encrypted_data[..57],
+    ].concat());
+
+    let cipher = AesGcm::<Aes128, U16>::new_from_slice(&symmetric[..16])
+        .map_err(|_| PushError::BadMsg)?;
+    cipher
+        .decrypt(Nonce::from_slice(&symmetric[16..]), &encrypted_data[57..])
+        .map_err(|_| PushError::BadMsg)
+}
+
+fn decrypt_secure_friend_location(
+    private_key: &[u8],
+    encoded_location: &str,
+    payload_format: i64,
+    outer_timestamp: i64,
+) -> Result<DecodedSecureFriendLocation, PushError> {
+    // FindMyCrypto.PrivateKey is the 57-byte uncompressed P-224 public point
+    // followed by the 28-byte private scalar. Secure People reports use
+    // Security.framework's variable-IV ECIES envelope.
+    if private_key.len() != 85 {
+        return Err(PushError::BadMsg);
+    }
+    let payload = base64_decode(encoded_location);
+    if payload.len() < 5 + 57 + 16 {
+        return Err(PushError::BadMsg);
+    }
+
+    #[cfg(not(target_os = "macos"))]
+    let timestamp_seconds = u32::from_be_bytes(
+        payload[..4].try_into().map_err(|_| PushError::BadMsg)?,
+    ) as u64 + 978_307_200;
+    #[cfg(target_os = "macos")]
+    {
+        // SecureLocationsPayloadFormat.jsonFull is a Security.framework ECIES
+        // envelope containing the JSON-encoded SecureLocation. Unlike Find My
+        // network beacon reports, it has no advertised-key/timestamp prefix:
+        // searchpartyd passes the complete `location` Data to
+        // SecKeyCreateDecryptedData.
+        if payload_format == 0 {
+            if let Ok(decrypted) = decrypt_secure_friend_ecies(private_key, &payload) {
+                let value: serde_json::Value = serde_json::from_slice(&decrypted)
+                    .map_err(|_| PushError::BadMsg)?;
+                debug!(
+                    "Authenticated secure Find My Friends jsonFull report encrypted_len={}, plaintext_len={}, plaintext_shape={}",
+                    payload.len(),
+                    decrypted.len(),
+                    json_shape(&value),
+                );
+                let latitude = value
+                    .get("latitude")
+                    .and_then(serde_json::Value::as_f64)
+                    .ok_or(PushError::BadMsg)?;
+                let longitude = value
+                    .get("longitude")
+                    .and_then(serde_json::Value::as_f64)
+                    .ok_or(PushError::BadMsg)?;
+                let horizontal_accuracy = value
+                    .get("horizontalAccuracy")
+                    .and_then(serde_json::Value::as_f64)
+                    .unwrap_or_default();
+                if !(-90.0..=90.0).contains(&latitude)
+                    || !(-180.0..=180.0).contains(&longitude)
+                {
+                    return Err(PushError::BadMsg);
+                }
+                // Foundation's default Codable representation for Date is
+                // seconds since 2001-01-01. Keep the response's locationTs as
+                // a compatibility fallback for future payload revisions.
+                let timestamp = value
+                    .get("timestamp")
+                    .and_then(serde_json::Value::as_f64)
+                    .filter(|timestamp| timestamp.is_finite())
+                    .map(|timestamp| ((timestamp + 978_307_200.0) * 1000.0) as i64)
+                    .unwrap_or_else(|| {
+                        if outer_timestamp.abs() >= 10_000_000_000 {
+                            outer_timestamp
+                        } else {
+                            outer_timestamp.saturating_mul(1000)
+                        }
+                    });
+                return Ok(DecodedSecureFriendLocation {
+                    latitude,
+                    longitude,
+                    horizontal_accuracy,
+                    timestamp,
+                });
+            }
+        }
+
+        // Current BeaconPayloadv1 packets place the Apple timestamp at
+        // 32..36, metadata at 36, and the ECIES ciphertext at 37..end. The
+        // legacy packet uses the compact 0..4 / 4 / 5..end layout.
+        let (timestamp_offset, encrypted_offset) = if payload.len() >= 120 {
+            (32usize, 37usize)
+        } else {
+            (0usize, 5usize)
+        };
+        let timestamp_seconds = u32::from_be_bytes(
+            payload[timestamp_offset..timestamp_offset + 4]
+                .try_into()
+                .map_err(|_| PushError::BadMsg)?,
+        ) as u64 + 978_307_200;
+        let (decrypted, decrypt_format) =
+            match decrypt_secure_friend_ecies(private_key, &payload[encrypted_offset..]) {
+                Ok(decrypted) => (decrypted, "security-framework"),
+                Err(_) => {
+                    let negated_key = negated_p224_private_key(private_key)?;
+                    match decrypt_secure_friend_ecies(&negated_key, &payload[encrypted_offset..]) {
+                        Ok(decrypted) => (decrypted, "security-framework-negated"),
+                        Err(_) => (
+                            decrypt_secure_friend_custom_ecies(
+                                private_key,
+                                &payload[encrypted_offset..],
+                            )?,
+                            "custom-ecies",
+                        ),
+                    }
+                }
+            };
+        debug!(
+            "Authenticated secure Find My Friends report segment encrypted_len={}, plaintext_len={}, decrypt_format={decrypt_format}",
+            payload.len() - encrypted_offset,
+            decrypted.len(),
+        );
+        let (_, decoded) = EncryptedReport::from_bytes((&decrypted, 0))?;
+        if !(-900_000_000..=900_000_000).contains(&decoded.lat)
+            || !(-1_800_000_000..=1_800_000_000).contains(&decoded.long)
+        {
+            return Err(PushError::BadMsg);
+        }
+        return Ok(DecodedSecureFriendLocation {
+            latitude: decoded.lat as f64 / 10_000_000f64,
+            longitude: decoded.long as f64 / 10_000_000f64,
+            horizontal_accuracy: decoded.horizontal_accuracy as f64,
+            timestamp: i64::try_from(timestamp_seconds.saturating_mul(1000))
+                .map_err(|_| PushError::BadMsg)?,
+        });
+    }
+
+    #[cfg(not(target_os = "macos"))]
+    let encrypted_data = &payload[5..];
+
+    #[cfg(not(target_os = "macos"))]
+    {
+        let decrypted = decrypt_secure_friend_custom_ecies(private_key, encrypted_data)?;
+        let (_, decoded) = EncryptedReport::from_bytes((&decrypted, 0))?;
+
+        Ok(DecodedSecureFriendLocation {
+            latitude: decoded.lat as f64 / 10_000_000f64,
+            longitude: decoded.long as f64 / 10_000_000f64,
+            horizontal_accuracy: decoded.horizontal_accuracy as f64,
+            timestamp: i64::try_from(timestamp_seconds.saturating_mul(1000))
+                .map_err(|_| PushError::BadMsg)?,
+        })
+    }
+}
+
+fn secure_friend_fetch_request(
+    find_my_id: &str,
+    secure_location_ids: &[String],
+    aps_token: &[u8],
+    context_app: &str,
+) -> serde_json::Value {
+    let fetch = if secure_location_ids.is_empty() {
+        json!({
+            "fmId": find_my_id,
+            "intent": "distributeKeys",
+            "mode": "shallow",
+        })
+    } else {
+        json!({
+            "fmId": find_my_id,
+            "intent": "startLocationUpdates",
+            "mode": "shallow",
+            "ids": secure_location_ids,
+        })
+    };
+
+    json!({
+        "fetch": [fetch],
+        "clientContext": {
+            "apsToken": encode_hex(aps_token).to_uppercase(),
+            "clientId": encode_hex(&sha1(aps_token)),
+            // FindMyLocate.RequestOrigin obtains this from
+            // ProcessInfo.processIdentifier. SecureLocationsClientContext
+            // serializes the value as a decimal string.
+            "contextApp": context_app,
+            "shallowStats": {},
+            "liveStats": {
+                "errors": [],
+            },
+            "autoMeConnectedDevice": [],
+        },
+    })
 }

