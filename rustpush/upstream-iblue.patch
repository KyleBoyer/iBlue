+#[cfg(target_os = "macos")]
+fn negated_p224_private_key(private_key: &[u8]) -> Result<Vec<u8>, PushError> {
+    if private_key.len() != 85 {
+        return Err(PushError::BadMsg);
+    }
+    let group = EcGroup::from_curve_name(Nid::SECP224R1)?;
+    let mut context = BigNumContext::new()?;
+    let mut public = EcPoint::from_bytes(&group, &private_key[..57], &mut context)?;
+    public.invert(&group, &context)?;
+
+    let mut order = BigNum::new()?;
+    group.order(&mut order, &mut context)?;
+    let scalar = BigNum::from_slice(&private_key[57..])?;
+    let mut negated_scalar = BigNum::new()?;
+    negated_scalar.checked_sub(&order, &scalar)?;
+
+    let mut result = public.to_bytes(
+        &group,
+        PointConversionForm::UNCOMPRESSED,
+        &mut context,
+    )?;
+    result.extend_from_slice(&negated_scalar.to_vec_padded(28)?);
+    Ok(result)
+}
