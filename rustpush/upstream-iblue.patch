+fn plist_wrapped_string(value: &Value) -> Option<String> {
+    match value {
+        Value::String(value) => Some(value.clone()),
+        Value::Data(value) => std::str::from_utf8(value).ok().map(str::to_owned),
+        Value::Dictionary(values) => ["rawValue", "value", "identifier", "data", "_0"]
+            .into_iter()
+            .find_map(|key| values.get(key).and_then(plist_wrapped_string)),
+        Value::Array(values) if values.len() == 1 => plist_wrapped_string(&values[0]),
+        _ => None,
+    }
+}
+
+fn plist_wrapped_data(value: &Value) -> Option<Vec<u8>> {
+    match value {
+        Value::Data(value) => Some(value.clone()),
+        Value::Dictionary(values) => ["data", "rawValue", "value", "key", "keyMaterial", "_0"]
+            .into_iter()
+            .find_map(|key| values.get(key).and_then(plist_wrapped_data)),
+        Value::Array(values) if values.len() == 1 => plist_wrapped_data(&values[0]),
+        _ => None,
+    }
+}
+
+fn plist_wrapped_integer(value: &Value) -> Option<i64> {
+    value
+        .as_signed_integer()
+        .or_else(|| value.as_unsigned_integer().and_then(|value| i64::try_from(value).ok()))
+        .or_else(|| match value {
+            Value::Dictionary(values) => ["rawValue", "value", "index", "_0"]
+                .into_iter()
+                .find_map(|key| values.get(key).and_then(plist_wrapped_integer)),
+            Value::Array(values) if values.len() == 1 => plist_wrapped_integer(&values[0]),
+            _ => None,
+        })
+}
