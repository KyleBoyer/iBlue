+#[cfg(target_os = "macos")]
+fn decrypt_secure_friend_ecies(
+    private_key: &[u8],
+    encrypted: &[u8],
+) -> Result<Vec<u8>, PushError> {
+    use core_foundation::{
+        base::{CFType, TCFType},
+        data::CFData,
+        dictionary::CFDictionary,
+        error::CFError,
+        string::CFString,
+    };
+    use security_framework_sys::{
+        item::{
+            kSecAttrKeyClass, kSecAttrKeyClassPrivate, kSecAttrKeyType,
+            kSecAttrKeyTypeEC,
+        },
+        key::{
+            Algorithm, SecKeyCreateDecryptedData, SecKeyCreateWithData,
+            SecKeyIsAlgorithmSupported, kSecKeyOperationTypeDecrypt,
+        },
+    };
+
+    unsafe {
+        let key_type_name = CFString::wrap_under_get_rule(kSecAttrKeyType);
+        let key_type_ec = CFString::wrap_under_get_rule(kSecAttrKeyTypeEC);
+        let key_class_name = CFString::wrap_under_get_rule(kSecAttrKeyClass);
+        let key_class_private = CFString::wrap_under_get_rule(kSecAttrKeyClassPrivate);
+        let attributes = CFDictionary::from_CFType_pairs(&[
+            (key_type_name, key_type_ec),
+            (key_class_name, key_class_private),
+        ]);
+        let key_data = CFData::from_buffer(private_key);
+        let mut error = std::ptr::null_mut();
+        let key = SecKeyCreateWithData(
+            key_data.as_concrete_TypeRef(),
+            attributes.as_concrete_TypeRef(),
+            &mut error,
+        );
+        if !error.is_null() {
+            let error = CFError::wrap_under_create_rule(error);
+            debug!("Secure Find My Friends private key import failed code={}", error.code());
+            return Err(PushError::BadMsg);
+        }
+        if key.is_null() {
+            return Err(PushError::BadMsg);
+        }
+        let key_owner = CFType::wrap_under_create_rule(key.cast());
+
+        let encrypted_data = CFData::from_buffer(encrypted);
+        let algorithm = Algorithm::ECIESEncryptionStandardVariableIVX963SHA256AESGCM.into();
+        let algorithm_supported = SecKeyIsAlgorithmSupported(
+            key,
+            kSecKeyOperationTypeDecrypt,
+            algorithm,
+        ) != 0;
+        let mut error = std::ptr::null_mut();
+        let decrypted = SecKeyCreateDecryptedData(
+            key,
+            algorithm,
+            encrypted_data.as_concrete_TypeRef(),
+            &mut error,
+        );
+        drop(key_owner);
+        if !error.is_null() {
+            let error = CFError::wrap_under_create_rule(error);
+            debug!(
+                "Secure Find My Friends ECIES decrypt failed code={}, algorithm_supported={algorithm_supported}, encrypted_len={}",
+                error.code(),
+                encrypted.len(),
+            );
+            return Err(PushError::BadMsg);
+        }
+        if decrypted.is_null() {
+            return Err(PushError::BadMsg);
+        }
+        Ok(CFData::wrap_under_create_rule(decrypted).to_vec())
+    }
+}
