+/// Deliver one encrypted RTP packet to every participant on the call.
+///
+/// Media is encrypted exactly once. `my_mkm` is a single outbound key that each
+/// participant receives re-wrapped with its own prekey, so the ciphertext is
+/// identical for everyone and only the relay addressing differs. A one-to-one
+/// call with a validated direct pair keeps using that pair unchanged; group
+/// calls ride the relay, which routes by participant id.
+/// Every participant media should be delivered to, with `preferred` first so a
+/// one-to-one call behaves exactly as before. Participants without a control
+/// route are skipped: they have not joined and cannot decrypt yet.
+fn media_delivery_participants(
+    states: &HashMap<u64, ParticipantState>,
+    preferred: Option<u64>,
+) -> Vec<u64> {
+    let mut participants = Vec::new();
+    if let Some(first) = preferred {
+        if states.contains_key(&first) {
+            participants.push(first);
+        }
+    }
+    let mut others = states
+        .iter()
+        .filter(|(participant, state)| {
+            Some(**participant) != preferred && state.avc_uuid.is_some()
+        })
+        .map(|(participant, _)| *participant)
+        .collect::<Vec<_>>();
+    others.sort_unstable();
+    participants.extend(others);
+    if participants.is_empty() {
+        if let Some(first) = preferred {
+            participants.push(first);
+        }
+    }
+    participants
+}
+
+async fn deliver_encrypted_rtp(
+    encrypted: &[u8],
+    peer_participants: &[u64],
+    direct_socket: Option<&Arc<UdpSocket>>,
+    direct_peer: Option<SocketAddr>,
+    avc_pod: &Pod,
+) -> Result<(), PushError> {
+    if peer_participants.len() <= 1 {
+        if let (Some(socket), Some(peer)) = (direct_socket, direct_peer) {
+            socket
+                .send_to(encrypted, peer)
+                .await
+                .map_err(|_| PushError::NotConnected)?;
+            return Ok(());
+        }
+    }
+    if peer_participants.is_empty() {
+        let framed = GlobalPacket {
+            participant: None,
+            link: LinkType::Pod,
+            data: encrypted.to_vec(),
+        }
+        .to_qr_raw();
+        avc_pod
+            .send_datagram(framed.into())
+            .map_err(|_| PushError::NotConnected)?;
+        return Ok(());
+    }
+    for participant in peer_participants {
+        let framed = GlobalPacket {
+            participant: Some(*participant),
+            link: LinkType::Pod,
+            data: encrypted.to_vec(),
+        }
+        .to_qr_raw();
+        avc_pod
+            .send_datagram(framed.into())
+            .map_err(|_| PushError::NotConnected)?;
+    }
+    Ok(())
+}
