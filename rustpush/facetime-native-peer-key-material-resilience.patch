+    /// How many participants this side has published key material to, and how
+    /// many have delivered usable media key material back. Readiness is a
+    /// property of that exchange rather than of the command that carried it.
+    pub async fn key_exchange_state(&self) -> (usize, usize) {
+        let state = self.state.lock().await;
+        (
+            state
+                .states
+                .values()
+                .filter(|peer| peer.outgoing_key_material.is_some())
+                .count(),
+            state
+                .states
+                .values()
+                .filter(|peer| !peer.mkm.is_empty())
+                .count(),
+        )
+    }
