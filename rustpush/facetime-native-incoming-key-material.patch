+    /// Return the encrypted media/session material already posted to
+    /// QuickRelay, keyed by its intended peer participant. The FaceTime IDS
+    /// layer mirrors these exact values in command 211 for Apple responders.
+    pub async fn outgoing_key_materials(
+        &self,
+    ) -> Vec<(u64, QuickRelayMkmMaterial, QuickRelaySkmMaterial)> {
+        let state = self.state.lock().await;
+        state
+            .states
+            .iter()
+            .filter_map(|(participant, peer)| {
+                peer.outgoing_key_material
+                    .as_ref()
+                    .map(|(mkm, skm)| (*participant, mkm.clone(), skm.clone()))
+            })
+            .collect()
+    }
+
+    pub async fn participant_handles(&self) -> Vec<String> {
+        let state = self.state.lock().await;
+        let mut handles = state
+            .configuration
+            .allocations
+            .iter()
+            .map(|allocation| allocation.participant.clone())
+            .collect::<Vec<_>>();
+        handles.sort();
+        handles.dedup();
+        handles
+    }
+
+    /// Deliver a FaceTime IDS side-channel message to all allocated devices or
+    /// to the device represented by one QuickRelay participant ID.
+    pub async fn message_participants(
+        &self,
+        participant: Option<u64>,
+        message: IDSSendMessage,
+    ) -> Result<(), PushError> {
+        let relevant_people = self.participant_handles().await;
+        let topic = "com.apple.private.alloy.facetime.multi";
+        self.identity
+            .cache_keys(
+                topic,
+                &relevant_people,
+                &self.handle,
+                false,
+                &QueryOptions {
+                    required_for_message: true,
+                    result_expected: true,
+                },
+            )
+            .await?;
+        let targets = if let Some(participant) = participant {
+            let token = self
+                .state
+                .lock()
+                .await
+                .configuration
+                .allocations
+                .iter()
+                .find(|allocation| allocation.id == participant as i64)
+                .map(|allocation| allocation.token.as_ref().to_vec())
+                .ok_or(PushError::BadMsg)?;
+            self.identity.cache.lock().await.get_targets(
+                topic,
+                &self.handle,
+                &relevant_people,
+                &[MessageTarget::Token(token)],
+            )?
+        } else {
+            self.identity
+                .cache
+                .lock()
+                .await
+                .get_participants_targets(topic, &self.handle, &relevant_people)
+        };
+        self.identity.send_message(topic, message, targets).await?;
+        Ok(())
     }
 
