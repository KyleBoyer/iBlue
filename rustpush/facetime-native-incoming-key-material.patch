+    /// Apple mirrors responder MKM/SKM through IDS command 211 in addition to
+    /// publishing it on QuickRelay. Some callers do not activate the remote
+    /// control/media decryptor until this participant-targeted copy arrives.
+    async fn publish_native_key_material(&self, session: &FTSession) -> Result<(), PushError> {
+        let connection = session.connection.as_ref().ok_or(PushError::NotConnected)?;
+        let all_mkm_uri = connection.link.participant_handles().await;
+        let expires = SystemTime::now()
+            .checked_add(Duration::from_secs(605))
+            .ok_or(PushError::BadMsg)?
+            .duration_since(SystemTime::UNIX_EPOCH)
+            .map_err(|_| PushError::BadMsg)?
+            .as_secs();
+        for (participant, media_key_material, session_key_material) in
+            connection.link.outgoing_key_materials().await
+        {
+            let wire_message = FTWireMessage {
+                session: session.group_id.clone(),
+                session_key_material: Some(session_key_material),
+                media_key_material: Some(media_key_material),
+                all_mkm_uri: Some(all_mkm_uri.clone()),
+                fanout_groupid: session.group_id.clone(),
+                ..Default::default()
+            };
+            connection
+                .link
+                .message_participants(
+                    Some(participant),
+                    IDSSendMessage {
+                        sender: connection.link.handle.clone(),
+                        raw: Raw::Body(plist_to_bin(&wire_message)?),
+                        send_delivered: false,
+                        command: 211,
+                        no_response: false,
+                        id: Uuid::new_v4().to_string().to_uppercase(),
+                        scheduled_ms: None,
+                        queue_id: None,
+                        relay: None,
+                        extras: Dictionary::from_iter([
+                            ("siu", Value::Boolean(false)),
+                            ("eX", Value::Integer(expires.into())),
+                        ]),
+                    },
+                )
+                .await?;
+        }
         Ok(())
     }
 
