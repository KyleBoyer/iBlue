+    fn parse_audio_feedback(header: &rtc_rtp::Header) -> Option<(u16, u16, u16)> {
+        if !matches!(header.payload_type, 20 | 104 | 108 | 13) || !header.extension {
+            return None;
+        }
+        let payload = header.extensions.first()?.payload.as_ref();
+        if header.extension_profile >> 14 != 2 || payload.len() < 6 {
+            return None;
+        }
+        let feedback_sequence = u16::from_be_bytes(payload[0..2].try_into().ok()?);
+        let total_kb_received = u16::from_be_bytes(payload[2..4].try_into().ok()?);
+        let packed_audio_receive_stats = u16::from_be_bytes(payload[4..6].try_into().ok()?);
+        Some((
+            feedback_sequence,
+            total_kb_received,
+            packed_audio_receive_stats & 0x0fff,
+        ))
+    }
