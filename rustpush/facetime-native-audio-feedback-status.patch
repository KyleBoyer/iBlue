+            if let Some((sequence, total_kb, packets)) = Self::parse_audio_feedback(header) {
+                state.audio_feedback_updates = state.audio_feedback_updates.saturating_add(1);
+                state.audio_feedback_sequence = sequence;
+                state.audio_feedback_total_kb_received = total_kb;
+                state.audio_feedback_packets_received = packets;
+            }
         }
     }
 
