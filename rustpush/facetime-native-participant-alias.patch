+
+/// Prefer the participant carried by the relay packet, but do not treat that
+/// identifier as a cryptographic identity. Some Apple callers use a transient
+/// AVC owner participant that differs from the allocation associated with the
+/// same IDS device token. Authentication still unambiguously identifies the
+/// right state because every candidate uses a distinct MKM/UUID context.
+fn control_participant_candidates(
+    states: &HashMap<u64, ParticipantState>,
+    participant_hint: Option<u64>,
+) -> Vec<u64> {
+    let mut candidates = states.keys().copied().collect::<Vec<_>>();
+    candidates.sort_unstable();
+    if let Some(hint) = participant_hint {
+        if let Some(index) = candidates.iter().position(|candidate| *candidate == hint) {
+            candidates.swap(0, index);
         }
     }
     candidates
 }
 
+fn control_key_participant(
+    aliases: &HashMap<u64, u64>,
+    route_participant: u64,
+) -> u64 {
+    aliases
+        .get(&route_participant)
+        .copied()
+        .unwrap_or(route_participant)
+}
