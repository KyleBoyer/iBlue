+    /// Resolve the SRTP master material for an inbound packet from the
+    /// two-byte key selector it carries.
+    ///
+    /// Apple ratchets that selector within a call and every sender in a group
+    /// call has its own, so the first key of an arbitrary participant is only
+    /// ever correct by luck. Prefer the participant the relay named, then fall
+    /// back to any peer holding a key with this selector, which is what makes
+    /// a call survive a peer's mid-call rekey.
+    ///
+    /// Returns the master material and whether it was reached by an exact
+    /// selector match. A peer that advertises a short-MKI length other than
+    /// two is not putting this selector on the wire at all, so its key is
+    /// still usable; anything else that fails to match is somebody else's
+    /// packet or a generation this side has not been given.
+    pub async fn inbound_media_key(
+        &self,
+        participant: Option<u64>,
+        short_mki: [u8; 2],
+        ssrc: u32,
+    ) -> Option<([u8; 30], bool)> {
+        let state = self.state.lock().await;
+        let key_participant = participant.map(|participant| {
+            control_key_participant(&state.control_participant_aliases, participant)
+        });
+        let select = |peer: &ParticipantState| {
+            peer.mkm
+                .iter()
+                .find(|material| material.mki.starts_with(&short_mki))
+                .map(|material| material.get_key(ssrc))
+        };
+        if let Some(key) = key_participant
+            .and_then(|key_participant| state.states.get(&key_participant))
+            .and_then(select)
+        {
+            return Some((key, true));
+        }
+        if let Some(key) = state.states.values().find_map(select) {
+            return Some((key, true));
+        }
+        // No selector match. Only a sender that is not using Apple's two-byte
+        // selector can still be decrypted from what we hold.
+        let unselected = |peer: &ParticipantState| {
+            peer.mkm
+                .iter()
+                .find(|material| material.smkil != APPLE_RTP_SHORT_MKI.len() as u32)
+                .map(|material| material.get_key(ssrc))
+        };
+        if let Some(key) = key_participant
+            .and_then(|key_participant| state.states.get(&key_participant))
+            .and_then(unselected)
+        {
+            return Some((key, false));
+        }
+        state
+            .states
+            .values()
+            .find_map(unselected)
+            .map(|key| (key, false))
+    }
