+/// Locate the two-byte SRTP key selector Apple appends after the ciphertext.
+///
+/// The layout is `ciphertext || MKI || [rollover trailer] || auth tag`, and the
+/// four-byte rollover trailer only rides on every 128th packet, so the selector
+/// sits at one of two offsets within a single stream.
+fn inbound_srtp_short_mki(
+    data: &[u8],
+    sequence_number: u16,
+    auth_tag_len: usize,
+) -> Option<[u8; 2]> {
+    let trailer_len = if sequence_number & 0x7f == 0 { 4 } else { 0 };
+    let end = data.len().checked_sub(auth_tag_len + trailer_len)?;
+    let start = end.checked_sub(2)?;
+    data.get(start..end)?.try_into().ok()
+}
