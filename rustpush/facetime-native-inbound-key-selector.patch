+#[cfg(test)]
+mod tests {
+    use super::inbound_srtp_short_mki;
+
+    #[test]
+    fn srtp_key_selector_sits_before_the_auth_tag() {
+        // ciphertext | selector | auth tag
+        let packet = [
+            0x90, 0x68, 0x00, 0x01, 0xaa, 0xbb, 0xcc, 0xdd,
+            0x00, 0x10,
+            0x01, 0x02, 0x03, 0x04,
+        ];
+        assert_eq!(inbound_srtp_short_mki(&packet, 1, 4), Some([0x00, 0x10]));
+    }
+
+    #[test]
+    fn srtp_key_selector_moves_ahead_of_the_rollover_trailer() {
+        // ciphertext | selector | rollover trailer | auth tag
+        let packet = [
+            0x90, 0x68, 0x00, 0x00, 0xaa, 0xbb, 0xcc, 0xdd,
+            0x00, 0x11,
+            0x00, 0x00, 0x00, 0x20,
+            0x01, 0x02, 0x03, 0x04,
+        ];
+        assert_eq!(inbound_srtp_short_mki(&packet, 128, 4), Some([0x00, 0x11]));
+        // Every 128th sequence number carries the trailer, including zero.
+        assert_eq!(inbound_srtp_short_mki(&packet, 0, 4), Some([0x00, 0x11]));
+    }
+
+    #[test]
+    fn video_packets_reserve_a_ten_byte_auth_tag() {
+        let mut packet = vec![0x90, 0x64, 0x00, 0x01, 0xaa, 0xbb, 0xcc, 0xdd];
+        packet.extend_from_slice(&[0x00, 0x12]);
+        packet.extend_from_slice(&[0xff; 10]);
+        assert_eq!(inbound_srtp_short_mki(&packet, 1, 10), Some([0x00, 0x12]));
+    }
+
+    #[test]
+    fn a_packet_too_short_to_carry_a_selector_is_refused() {
+        assert_eq!(inbound_srtp_short_mki(&[0x90, 0x68, 0x00], 1, 4), None);
+        assert_eq!(inbound_srtp_short_mki(&[], 1, 4), None);
+    }
