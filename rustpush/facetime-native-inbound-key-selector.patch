+    #[test]
+    fn ratcheting_media_key_material_changes_the_short_srtp_selector() {
+        let material = QuickRelayMkmMaterial::create(0xeb28_319a_d867_23b1);
+        let rolled = material.roll("0F7F1D96-2E3F-4E4F-9E8C-9D0F4A3C77B1").unwrap();
+
+        assert_eq!(&material.mki[..2], &APPLE_RTP_SHORT_MKI);
+        assert_ne!(&rolled.mki[..2], &material.mki[..2]);
+        assert_ne!(rolled.mkm, material.mkm);
+        assert_eq!(rolled.mkgc, material.mkgc + 1);
+    }
+
+    #[test]
+    fn registering_a_peer_key_covers_the_next_two_ratchets() {
+        let material = QuickRelayMkmMaterial::create(7);
+        let generations = material.current_and_next("SESSION", 3);
+
+        assert_eq!(generations.len(), 3);
+        let selectors: Vec<_> = generations
+            .iter()
+            .map(|material| material.mki[..2].to_vec())
+            .collect();
+        assert_eq!(selectors[0], APPLE_RTP_SHORT_MKI.to_vec());
+        assert_ne!(selectors[0], selectors[1]);
+        assert_ne!(selectors[1], selectors[2]);
+    }
