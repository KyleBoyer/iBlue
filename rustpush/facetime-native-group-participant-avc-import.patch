+    /// Record a participant's VC session UUID from its plaintext AVC blob.
+    ///
+    /// Ported from upstream's avconference import_avc. Incoming control is
+    /// authenticated against the peer session UUIDs held here, and this branch
+    /// otherwise only learns them by decrypting an AVC blob delivered over
+    /// QuickRelay. A group call never delivers that blob, so every participant
+    /// stays without a UUID and no control message can be authenticated. The
+    /// same value is already present in plaintext on each participant record.
+    pub async fn import_participant_avc(
+        &self,
+        participant_id: u64,
+        avc_data: &[u8],
+    ) -> Result<(), PushError> {
+        let avc: AVCData = plist::from_bytes(avc_data)?;
+        let session_id = avc.vc_session_participant_key_uuid;
+        if session_id.is_empty() {
+            return Ok(());
+        }
+        let mut state = self.state.lock().await;
+        let participant = state.states.entry(participant_id).or_default();
+        let changed = participant.avc_uuid.as_deref() != Some(session_id.as_str());
+        participant.avc_uuid = Some(session_id);
+        if changed && std::env::var("IBLUE_FACETIME_MEDIA_DIAGNOSTICS").as_deref() == Ok("1") {
+            warn!(
+                "Imported FaceTime participant AVC session UUID: participant={} peer_uuids={}",
+                participant_id,
+                state.states.values().filter(|peer| peer.avc_uuid.is_some()).count(),
+            );
+        }
+        Ok(())
+    }
