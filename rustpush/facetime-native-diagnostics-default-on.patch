+/// Whether FaceTime media diagnostics are emitted.
+///
+/// Default on. These lines are what make a failed call diagnosable after the
+/// fact, and a call that fails once is rarely reproducible on demand. Set
+/// `IBLUE_FACETIME_MEDIA_DIAGNOSTICS` to `0`, `false`, or `off` to silence
+/// them.
+pub fn media_diagnostics_enabled() -> bool {
+    match std::env::var("IBLUE_FACETIME_MEDIA_DIAGNOSTICS") {
+        Ok(value) => !matches!(
+            value.trim().to_ascii_lowercase().as_str(),
+            "0" | "false" | "off" | "no"
+        ),
+        Err(_) => true,
+    }
+}
