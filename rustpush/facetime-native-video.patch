+#[derive(Debug, Default, PartialEq, Eq)]
+struct NativeVideoControlData {
+    version: u8,
+    camera_status: u8,
+    ltr_bits: u8,
+    ltr_timestamp: Option<u32>,
+    total_packets_per_frame: Option<u16>,
+    frame_sequence_number: Option<u16>,
+    probe: Option<u32>,
+}
+
+impl NativeVideoControlData {
+    fn to_extension(&self) -> (u16, Vec<u8>) {
+        let profile = ((self.version as u16) << 14)
+            | ((self.camera_status as u16) << 8)
+            | ((self.ltr_bits as u16) << 4)
+            | if self.ltr_timestamp.is_some() { 0x2 } else { 0 }
+            | if self.total_packets_per_frame.is_some() && self.version == 2 {
+                0x1
+            } else {
+                0
+            }
+            | if self.probe.is_some() { 0x8 } else { 0 };
+        let payload = [
+            self.ltr_timestamp
+                .map(|value| value.to_be_bytes().to_vec())
+                .unwrap_or_default(),
+            if self.version == 2 {
+                self.total_packets_per_frame
+                    .map(|value| value.to_be_bytes().to_vec())
+                    .unwrap_or_default()
+            } else {
+                Vec::new()
+            },
+            if self.version == 2 {
+                self.frame_sequence_number
+                    .map(|value| value.to_be_bytes().to_vec())
+                    .unwrap_or_default()
+            } else {
+                Vec::new()
+            },
+            self.probe
+                .map(|value| value.to_be_bytes().to_vec())
+                .unwrap_or_default(),
+        ]
+        .concat();
+        (profile, payload)
+    }
+}
+
+fn append_native_hevc_footer(frame: &mut Vec<u8>) {
+    // The U1 H.265 feature order advertised by AVConfig is
+    // CH1, CR, CF, FA. This frame carries CH1, CR, and FA.
+    let footer = [
+        0x00, 0x00, // CH1
+        0x65, 0x43, 0x00, 0x00, // CR
+        0x3e, 0x3e, 0xc0, 0xc0, // FA
+        0x0b, // feature bits 0, 1, and 3
+    ];
+    for byte in footer {
+        frame.push(byte);
+        if frame.len() >= 3
+            && matches!(
+                &frame[frame.len() - 3..],
+                [0, 0, 0] | [0, 0, 1] | [0, 0, 2] | [0, 0, 3]
+            )
+        {
+            frame.insert(frame.len() - 1, 3);
+        }
+    }
+}
