+
+impl NativeVideoSender {
+    async fn send_frame(
+        &mut self,
+        mut frame: Vec<u8>,
+        description: Option<&[u8]>,
+    ) -> Result<(u64, u64), PushError> {
+        append_native_hevc_footer(&mut frame);
+        let mut payloads = self
+            .hevc
+            .payload(1024, &frame.into())
+            .map_err(|_| PushError::BadMsg)?;
+        if let Some(description) = description {
+            if description.len() > 64 * 1024 {
+                return Err(PushError::BadMsg);
+            }
+            let mut payload = Vec::with_capacity(description.len() + 4);
+            payload.extend_from_slice(&[0x92, 0xe6, 0xc0, 0xa3]);
+            payload.extend_from_slice(description);
+            payloads.insert(0, payload.into());
+        }
+        if payloads.is_empty() || payloads.len() > u16::MAX as usize {
+            return Err(PushError::BadMsg);
+        }
+
+        let elapsed_since_probe = self
+            .last_probe
+            .map(|instant| instant.elapsed())
+            .unwrap_or(std::time::Duration::from_secs(60));
+        let probe = if payloads.len() > 2
+            || (elapsed_since_probe > std::time::Duration::from_secs(5)
+                && payloads.len() > 1)
+            || elapsed_since_probe > std::time::Duration::from_secs(10)
+        {
+            let value = self.probe_number;
+            self.probe_number = self.probe_number.wrapping_add(1);
+            self.last_probe = Some(tokio::time::Instant::now());
+            Some(value)
+        } else {
+            None
+        };
+        let control = NativeVideoControlData {
+            version: 2,
+            // The upload pipeline emits display-ready landscape frames. A
+            // portrait camera status makes FaceTime rotate the decoded surface
+            // and stretch its edge pixels to fill the resulting geometry.
+            // Apple's low two camera-status bits encode LandscapeRight as 3.
