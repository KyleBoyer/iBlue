+    /// Publish this side's wrapped media and session key material to one
+    /// participant if that has not happened yet.
+    ///
+    /// This is upstream AVConference's `ensure_keys`: key material belongs to a
+    /// participant and is published the moment that participant's prekey
+    /// arrives, on whichever transport delivered it. The GlobalLink bootstrap
+    /// this branch inherited publishes once, for whoever had a prekey at that
+    /// instant, which makes a peer's ability to decrypt us depend on message
+    /// ordering it controls.
+    ///
+    /// Returns whether anything was published. Callers may fire this on every
+    /// prekey they see; a participant that already has material is a no-op.
+    pub async fn ensure_participant_keys(&self, participant: u64) -> Result<bool, PushError> {
+        let (has_prekey, already_published) = {
+            let state = self.state.lock().await;
+            let key_participant = control_key_participant(
+                &state.control_participant_aliases,
+                participant,
+            );
+            let peer = state.states.get(&key_participant);
+            (
+                peer.is_some_and(|peer| peer.prekey.is_some()),
+                peer.is_some_and(|peer| peer.outgoing_key_material.is_some()),
+            )
+        };
+        if !has_prekey || already_published {
+            return Ok(false);
+        }
+        self.republish_outgoing_key_materials(participant).await?;
+        Ok(true)
+    }
