+    pub async fn token_to_participant(&self, token: &[u8]) -> Option<u64> {
+        self.state
+            .lock()
+            .await
+            .configuration
+            .allocations
+            .iter()
+            .find(|allocation| allocation.token.as_ref() == token)
+            .map(|allocation| allocation.id as u64)
+    }
+
+    /// Import the IDS command-211 copy of peer keys. This is the reliable
+    /// side-channel equivalent of QuickRelay material types 13 and 14.
+    pub async fn import_peer_key_material(
+        &self,
+        participant_id: u64,
+        media: Option<QuickRelayMkmMaterial>,
+        session_material: Option<QuickRelaySkmMaterial>,
+    ) -> Result<(bool, bool), PushError> {
+        let relay_session_id = Uuid::from_bytes(
+            self.session_id
+                .clone()
+                .try_into()
+                .map_err(|_| PushError::BadMsg)?,
+        )
+        .to_string()
+        .to_uppercase();
+        let mut state = self.state.lock().await;
+        let decrypted_skm = if let Some(mut item) = session_material {
+            item.skm = state.decode_key_material(item.skm.as_ref())?;
+            Some(item)
+        } else {
+            None
+        };
+        let decrypted_mkm = if let Some(mut item) = media {
+            item.mkm = state.decode_key_material(item.mkm.as_ref())?;
+            Some(item)
+        } else {
+            None
+        };
+        let participant = state.states.entry(participant_id).or_default();
+        let mut skm_added = false;
+        if let Some(item) = decrypted_skm {
+            if !participant.skm.iter().any(|known| known.ski == item.ski) {
+                participant.skm.push(item);
+                participant.try_decrypt(&relay_session_id)?;
+                skm_added = true;
+            }
+        }
+        let mut mkm_added = false;
+        if let Some(item) = decrypted_mkm {
+            for material in item.current_and_next(&relay_session_id, 3) {
+                if participant.mkm.iter().any(|known| known.mki == material.mki) {
+                    continue;
+                }
+                participant.mkm.push(material);
+                mkm_added = true;
+            }
+        }
+        Ok((mkm_added, skm_added))
     }
 
