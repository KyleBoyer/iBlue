+    #[test]
+    fn control_is_addressed_to_the_device_that_joined() {
+        // One caller, two registered devices: 11 answered, 22 only rang.
+        let mut states: HashMap<u64, ParticipantState> = HashMap::new();
+        states.insert(11, addressable("JOINED-UUID"));
+        states.insert(22, addressable("IDLE-UUID"));
+        let joined = HashSet::from([11u64]);
+
+        // An alias learned onto the idle device must not win over the joined one.
+        let aliases = HashMap::from([(99u64, 22u64)]);
+        assert_eq!(control_target_participant(&states, &aliases, &joined, 99), 11);
+
+        // Nor may the route participant itself, when it is the idle device.
+        let no_alias: HashMap<u64, u64> = HashMap::new();
+        assert_eq!(control_target_participant(&states, &no_alias, &joined, 22), 11);
+
+        // When the alias already points at the joined device, it is kept.
+        let good = HashMap::from([(99u64, 11u64)]);
+        assert_eq!(control_target_participant(&states, &good, &joined, 99), 11);
+    }
