+/// Choose the participant a VC control message should be addressed to.
+///
+/// A caller with several registered Apple devices invites all of them, so this
+/// link can hold a participant context per device. Only the device that
+/// actually joined has a live AVC session; control addressed to any other
+/// context is silently dropped by the peer, which then never acknowledges the
+/// stream group state and never publishes its own, and the call stalls with no
+/// media. Prefer a joined device that has an AVC UUID, and fall back to the
+/// previous alias behaviour while no join has been observed yet — control
+/// traffic can precede the join notification.
+fn control_target_participant(
+    states: &HashMap<u64, ParticipantState>,
+    aliases: &HashMap<u64, u64>,
+    joined: &HashSet<u64>,
+    route_participant: u64,
+) -> u64 {
+    let aliased = control_key_participant(aliases, route_participant);
+    let addressable =
+        |participant: u64| states.get(&participant).is_some_and(|state| state.avc_uuid.is_some());
+    for candidate in [aliased, route_participant] {
+        if joined.contains(&candidate) && addressable(candidate) {
+            return candidate;
+        }
+    }
+    let mut joined_candidates = joined
+        .iter()
+        .copied()
+        .filter(|participant| addressable(*participant))
+        .collect::<Vec<_>>();
+    joined_candidates.sort_unstable();
+    joined_candidates.first().copied().unwrap_or(aliased)
+}
