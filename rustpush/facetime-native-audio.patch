+    pub async fn send_audio_packets(
+        &self,
+        ssrc: u32,
+        packets: Vec<Vec<u8>>,
+        samples_per_packet: u32,
+    ) -> Result<(), PushError> {
+        let (avc_pod, key) = {
+            let state = self.state.lock().await;
+            (
+                state.avc_pod.clone().ok_or(PushError::NotConnected)?,
+                state.my_mkm.get_key(ssrc),
+            )
+        };
+        let mut context = Context::new(
+            &key[..16],
+            &key[16..],
+            ProtectionProfile::Aes128CmHmacSha2mki_32,
+            None,
+            None,
+        ).map_err(|_| PushError::BadMsg)?;
+        let mut sequence_number: u16 = rand::random();
+        let mut timestamp: u32 = rand::random();
+        let started = tokio::time::Instant::now();
+
+        for (index, payload) in packets.into_iter().enumerate() {
+            let packet = rtc_rtp::Packet {
+                header: rtc_rtp::Header {
+                    version: 2,
+                    payload_type: 104,
+                    sequence_number,
+                    timestamp,
+                    ssrc,
+                    ..Default::default()
+                },
+                payload: payload.into(),
+            };
+            let plaintext = packet.marshal().map_err(|_| PushError::BadMsg)?;
+            let encrypted = context.encrypt_rtp(&plaintext).map_err(|_| PushError::BadMsg)?;
+            let framed = GlobalPacket {
+                participant: None,
+                link: LinkType::Pod,
+                data: encrypted.to_vec(),
+            }.to_qr_raw();
+            avc_pod.send_datagram(framed.into()).map_err(|_| PushError::NotConnected)?;
+
+            sequence_number = sequence_number.wrapping_add(1);
+            timestamp = timestamp.wrapping_add(samples_per_packet);
+            let deadline = started + std::time::Duration::from_millis((index as u64 + 1) * 10);
+            tokio::time::sleep_until(deadline).await;
+        }
+        Ok(())
+    }
