+/// Return only the current (non-redundant) codec frames from an Apple audio
+/// RTP payload. PT20 is RFC 2198 RED; PT104 then wraps each AAC-ELD access unit
+/// with a one-byte length. EVS PT108 is one complete frame without that prefix.
+fn primary_facetime_audio_frames(payload_type: u8, payload: &[u8]) -> Option<(u8, Vec<Vec<u8>>)> {
+    let (primary_type, primary) = if payload_type == 20 {
+        let mut cursor = 0usize;
+        let mut blocks: Vec<(u8, Option<usize>)> = Vec::new();
+        loop {
+            let first = *payload.get(cursor)?;
+            cursor += 1;
+            let pt = first & 0x7f;
+            if first & 0x80 == 0 {
+                blocks.push((pt, None));
+                break;
+            }
+            let timestamp_and_length = payload.get(cursor..cursor + 3)?;
+            let block_len = (((timestamp_and_length[1] & 0x03) as usize) << 8)
+                | timestamp_and_length[2] as usize;
+            cursor += 3;
+            blocks.push((pt, Some(block_len)));
+        }
+        let mut block_cursor = cursor;
+        for (_, block_len) in blocks.iter().take(blocks.len().saturating_sub(1)) {
+            block_cursor = block_cursor.checked_add((*block_len)?)?;
+        }
+        let (primary_type, _) = *blocks.last()?;
+        (primary_type, payload.get(block_cursor..)?.to_vec())
+    } else {
+        (payload_type, payload.to_vec())
+    };
+
+    match primary_type {
+        104 => {
+            let mut frames = Vec::new();
+            let mut cursor = 0usize;
+            while cursor < primary.len() {
+                let size = *primary.get(cursor)? as usize;
+                cursor += 1;
+                let end = cursor.checked_add(size)?;
+                frames.push(primary.get(cursor..end)?.to_vec());
+                cursor = end;
+            }
+            (!frames.is_empty()).then_some((primary_type, frames))
+        }
+        108 if !primary.is_empty() => Some((primary_type, vec![primary])),
+        _ => None,
+    }
+}
