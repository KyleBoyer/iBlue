+/// Learn the public address of a media socket with a STUN binding request.
+///
+/// FaceTime publishes ICE candidates; iBlue previously published only the host
+/// (private LAN) address, which pairs successfully when the caller is on the
+/// same network and is unroutable from anywhere else. Querying from the media
+/// socket itself yields the mapping peers will actually see. Endpoint-
+/// independent (cone) NAT gives a mapping valid for every destination; under
+/// symmetric NAT the learned mapping will not match and pairing still fails,
+/// which is a property of the network rather than something to work around.
+async fn discover_reflexive_candidate(socket: &UdpSocket) -> Option<([u8; 4], u16)> {
+    use rtc_stun::message::{Message, TransactionId};
+    const STUN_SERVERS: [&str; 3] = [
+        "stun.l.google.com:19302",
+        "stun1.l.google.com:19302",
+        "stun.cloudflare.com:3478",
+    ];
+    let mut buf = [0u8; 2048];
+    for server in STUN_SERVERS {
+        let Ok(resolved) = tokio::net::lookup_host(server).await else { continue };
+        let Some(target) = resolved.into_iter().find(|addr| addr.is_ipv4()) else { continue };
+        let mut request = Message::new();
+        if request
+            .build(&[Box::new(BINDING_REQUEST), Box::new(TransactionId::new())])
+            .is_err()
+        {
+            continue;
+        }
+        if socket.send_to(&request.raw, target).await.is_err() { continue }
+        let received = tokio::time::timeout(
+            std::time::Duration::from_secs(2),
+            socket.recv_from(&mut buf),
+        ).await;
+        let Ok(Ok((len, from))) = received else { continue };
+        if from != target { continue }
+        let mut response = Message::new();
+        if response.unmarshal_binary(&buf[..len]).is_err() { continue }
+        let mut mapped = XorMappedAddress::default();
+        if mapped.get_from(&response).is_err() { continue }
+        if let std::net::IpAddr::V4(ip) = mapped.ip {
+            return Some((ip.octets(), mapped.port));
+        }
+    }
+    None
+}
