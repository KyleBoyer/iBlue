+/// Describe a peer's advertised media key parameters without ever printing key
+/// bytes. The wrap mode, the short-MKI length, and the generation counters are
+/// the fields most likely to differ between Apple releases, and a call that
+/// fails against one peer leaves no record of them today.
+fn describe_peer_mkm(material: &QuickRelayMkmMaterial) -> String {
+    format!(
+        "participant={} wrap_mode={} short_mki={} mki_len={} short_mki_len={} generation={}",
+        material.participant_id,
+        material.rtmpwm,
+        encode_hex(&material.mki[..material.mki.len().min(2)]),
+        material.mki.len(),
+        material.smkil,
+        material.mkgc,
+    )
+}
+
+fn describe_peer_skm(material: &QuickRelaySkmMaterial) -> String {
+    format!(
+        "participant={} wrap_mode={} ski_len={} generation={}",
+        material.participant_id,
+        material.rtmpwm,
+        material.ski.len(),
+        material.skgc,
+    )
+}
+
