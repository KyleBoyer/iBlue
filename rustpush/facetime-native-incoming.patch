+    /// Answer a peer-initiated one-to-one call with this profile's native
+    /// QuickRelay participant. No new session or web guest is created.
+    pub async fn answer_incoming_native(&self, group_id: &str) -> Result<(), PushError> {
+        let mut state = self.state.write().await;
+        let session = state.sessions.get_mut(group_id).ok_or(PushError::BadMsg)?;
+        if !matches!(session.mode, Some(FTMode::Incoming)) || !session.is_ringing_inaccurate {
+            return Err(PushError::BadMsg);
+        }
+        if session.av_config.is_none() {
+            session.av_config = Some(AVConfig::new(self.os_config.as_ref()));
+        }
+        self.ensure_allocations(session, &[]).await?;
+        self.prop_up_conv(session, false).await?;
+        session.is_ringing_inaccurate = false;
+        (self.update_state)(&state);
+        Ok(())
+    }
+
+    /// Decline a still-ringing peer-initiated call without creating a relay
+    /// allocation or advertising an active participant.
+    pub async fn decline_incoming_native(&self, group_id: &str) -> Result<(), PushError> {
+        let mut state = self.state.write().await;
+        let session = state.sessions.get_mut(group_id).ok_or(PushError::BadMsg)?;
+        if !matches!(session.mode, Some(FTMode::Incoming)) || !session.is_ringing_inaccurate {
+            return Err(PushError::BadMsg);
+        }
+        self.decline_invite(session).await?;
+        session.is_ringing_inaccurate = false;
+        session.mode = Some(FTMode::Missed);
+        (self.update_state)(&state);
+        Ok(())
+    }
