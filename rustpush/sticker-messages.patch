+#[cfg(test)]
+mod sticker_extension_tests {
+    use super::*;
+
+    #[test]
+    fn sticker_attribution_survives_keyed_archive_round_trip() {
+        let app = ExtensionApp {
+            name: "Stickers".to_string(),
+            app_id: None,
+            bundle_id: "com.apple.messages.MSMessageExtensionBalloonPlugin:0000000000:com.apple.Stickers.UserGenerated.MessagesExtension".to_string(),
+            attribution: ExtensionAttribution {
+                accessl: Some("Sticker".to_string()),
+                pgensh: Some(1_024.0),
+                pgensw: Some(842.0),
+                pgenszc: Some(StickerGenerationMetadata {
+                    class: NSDictionaryClass::NSDictionary,
+                    gm: false,
+                    iaig: false,
+                    mpw: "600".to_string(),
+                    mth: "100".to_string(),
+                    mtw: "100".to_string(),
+                    s: "1".to_string(),
+                    st: false,
+                }),
+            },
+            balloon: None,
+        };
+
+        let (ati, balloon) = app.to_raw().unwrap();
+        assert!(balloon.is_none());
+        let decoded = ExtensionApp::from_ati(&ati, None).unwrap();
+        assert_eq!(decoded.attribution.accessl.as_deref(), Some("Sticker"));
+        assert_eq!(decoded.attribution.pgensh, Some(1_024.0));
+        assert_eq!(decoded.attribution.pgensw, Some(842.0));
+        assert!(decoded.attribution.pgenszc.is_some());
+    }
+
+    #[test]
+    fn sticker_xml_uses_extension_metadata_without_message_part() {
+        let parts = MessageParts(vec![IndexedMessagePart {
+            part: MessagePart::Attachment(Attachment {
+                a_type: AttachmentType::Inline(vec![1, 2, 3]),
+                part: 0,
+                uti_type: "public.heic".to_string(),
+                mime: "image/heic".to_string(),
+                name: "sticker.heic".to_string(),
+                iris: false,
+            }),
+            idx: Some(0),
+            ext: Some(PartExtension::Sticker {
+                msg_width: 163.73095703,
+                rotation: 0.0,
+                sai: 0,
+                scale: 0.5,
+                update: None,
+                sli: 0,
+                normalized_x: 0.0,
+                normalized_y: 0.98,
+                version: 0,
+                hash: "0123456789abcdef0123456789abcdef".to_string(),
+                safi: 0,
+                effect_type: -1,
+                sticker_id: "sticker.heic".to_string(),
+                pid: Some("com.apple.Stickers.UserGenerated.MessagesExtension".to_string()),
+                suri: Some("sha256://fixture".to_string()),
+            }),
+        }]);
+
+        let xml = parts.to_xml(None);
+        assert!(!xml.contains("message-part="));
+        assert!(xml.contains("pid=\"com.apple.Stickers.UserGenerated.MessagesExtension\""));
+        assert!(xml.contains("suri=\"sha256://fixture\""));
+    }
+
+    #[test]
+    fn sticker_update_flag_round_trips_as_boolean() {
+        let extension = PartExtension::Sticker {
+            msg_width: 163.73095703,
+            rotation: 0.0,
+            sai: 0,
+            scale: 0.5,
+            update: Some(false),
+            sli: 0,
+            normalized_x: 0.0,
+            normalized_y: 0.98,
+            version: 0,
+            hash: "0123456789abcdef0123456789abcdef".to_string(),
+            safi: 0,
+            effect_type: -1,
+            sticker_id: "sticker.heic".to_string(),
+            pid: None,
+            suri: None,
+        };
+
+        let value = plist::to_value(&extension).unwrap();
+        assert_eq!(value.as_dictionary().unwrap().get("sir").unwrap().as_boolean(), Some(false));
+        let decoded: PartExtension = plist::from_value(&value).unwrap();
+        assert!(matches!(decoded, PartExtension::Sticker { update: Some(false), .. }));
+    }
+}
