+#[derive(Deserialize, Clone, Default)]
+pub struct ExtensionAttribution {
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub accessl: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub pgensh: Option<f64>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub pgensw: Option<f64>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub pgenszc: Option<StickerGenerationMetadata>,
+}
+
+impl Serialize for ExtensionAttribution {
+    fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>
+    where
+        S: Serializer,
+    {
+        let mut fields = serializer.serialize_map(None)?;
+        if let Some(accessibility_label) = &self.accessl {
+            fields.serialize_entry("accessl", accessibility_label)?;
+        }
+        if let Some(height) = self.pgensh {
+            fields.serialize_entry("pgensh", &height)?;
+        }
+        if let Some(width) = self.pgensw {
+            fields.serialize_entry("pgensw", &width)?;
+        }
+        if let Some(metadata) = &self.pgenszc {
+            fields.serialize_entry("pgenszc", metadata)?;
+        }
+        fields.end()
+    }
+}
+
+#[derive(Serialize, Deserialize, Clone)]
