+/// A call-level clock shared by every live media sender. Apple U1 audio and
+/// video both use a 24 kHz RTP clock, so one epoch and timestamp origin let the
+/// receiver align the two SSRCs without relying on process startup order.
+#[derive(Clone)]
+pub struct NativeMediaClock {
+    epoch: tokio::time::Instant,
+    rtp_timestamp_base: u32,
+}
+
+impl NativeMediaClock {
+    pub fn new(epoch: tokio::time::Instant, rtp_timestamp_base: u32) -> Self {
+        Self {
+            epoch,
+            rtp_timestamp_base,
+        }
+    }
+
+    fn timestamp(&self, presentation_time_us: u64) -> u32 {
+        let ticks = ((presentation_time_us as u128 * 24_000) / 1_000_000) as u32;
+        self.rtp_timestamp_base.wrapping_add(ticks)
+    }
+
+    fn deadline(&self, presentation_time_us: u64) -> tokio::time::Instant {
+        self.epoch + std::time::Duration::from_micros(presentation_time_us)
+    }
+
+    fn lateness(&self, presentation_time_us: u64) -> std::time::Duration {
+        tokio::time::Instant::now().saturating_duration_since(self.deadline(presentation_time_us))
+    }
+
+    async fn wait(&self, presentation_time_us: u64) {
+        tokio::time::sleep_until(self.deadline(presentation_time_us)).await;
+    }
 }
 
