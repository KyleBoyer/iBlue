+fn frame_native_audio_payload(payload_type: u8, payload: Vec<u8>) -> Result<Vec<u8>, PushError> {
+    if !matches!(payload_type, 104 | 108) || payload.len() > u8::MAX as usize {
+        return Err(PushError::BadMsg);
+    }
+    let mut framed = Vec::with_capacity(payload.len() + 1);
+    framed.push(payload.len() as u8);
+    framed.extend_from_slice(&payload);
+    Ok(framed)
+}
+
+fn native_hevc_is_random_access(frame: &[u8]) -> bool {
+    let mut offset = 0usize;
+    while offset + 4 < frame.len() {
+        let start_code_len = if frame[offset..].starts_with(&[0, 0, 0, 1]) {
+            4
+        } else if frame[offset..].starts_with(&[0, 0, 1]) {
+            3
+        } else {
+            offset += 1;
+            continue;
+        };
+        let nal_offset = offset + start_code_len;
+        let nal_type = (frame[nal_offset] >> 1) & 0x3f;
+        if (16..=23).contains(&nal_type) {
+            return true;
+        }
+        offset = nal_offset + 1;
+    }
+    false
+}
