+    /// True only after the profile-owned relay has accepted AllocBind and the
+    /// IDS QPod has completed candidate and key-material bootstrap.
+    pub async fn native_media_ready(&self, group_id: &str) -> bool {
+        let connection = {
+            let state = self.state.read().await;
+            state.sessions.get(group_id).and_then(|session| session.connection.clone())
+        };
+        match connection {
+            Some(connection) => connection.link.is_bootstrapped().await,
+            None => false,
+        }
+    }
