+#[cfg(test)]
+mod tests {
+    use super::{APPLE_RTP_SHORT_MKI, QuickRelayMkmMaterial, apple_rtp_mki};
+
+    #[test]
+    fn outbound_media_key_id_matches_apple_short_mki() {
+        let participant_id = 0xeb28_319a_d867_23b1;
+        let material = QuickRelayMkmMaterial::create(participant_id);
+
+        assert_eq!(&material.mki[..2], &APPLE_RTP_SHORT_MKI);
+        assert_eq!(
+            material.mki,
+            [
+                0x00, 0x10, 0xeb, 0x28, 0x31, 0x9a, 0x00, 0xd8, 0x67, 0x23, 0xb1, 0x00,
+                0x00, 0x00, 0x00, 0x00,
+            ],
+        );
+        assert_eq!(material.mki, apple_rtp_mki(participant_id));
+        assert!(material.has_apple_rtp_short_mki());
+    }
