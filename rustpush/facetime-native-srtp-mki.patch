+const APPLE_RTP_SHORT_MKI: [u8; 2] = [0x00, 0x10];
+
+fn apple_rtp_mki(participant_id: u64) -> [u8; 16] {
+    // Apple's 16-byte material identifier carries the two-byte short MKI,
+    // followed by the QuickRelay participant ID split around a reserved byte.
+    // Only the first two bytes travel with SRTP, but the full identifier is
+    // how the receiver associates that selector with the advertised sender.
+    let mut mki = [0u8; 16];
+    mki[..2].copy_from_slice(&APPLE_RTP_SHORT_MKI);
+    mki[2..6].copy_from_slice(&((participant_id >> 32) as u32).to_be_bytes());
+    mki[7..11].copy_from_slice(&(participant_id as u32).to_be_bytes());
+    mki
+}
