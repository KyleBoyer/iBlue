 /// media. Prefer a joined device that has an AVC UUID, and fall back to the
 /// previous alias behaviour while no join has been observed yet — control
 /// traffic can precede the join notification.
+/// Describe every participant and which one control is addressed to.
+///
+/// A group call holds one participant context per remote device, and the
+/// difference that matters is which of them actually has decrypted peer key
+/// material. Reporting the whole table alongside the choice makes a stalled
+/// call diagnosable from one line instead of inference.
+fn report_control_target(
+    states: &HashMap<u64, ParticipantState>,
+    joined: &HashSet<u64>,
+    aliases: &HashMap<u64, u64>,
+    route_participant: u64,
+    chosen: u64,
+) {
+    let mut participants = states.keys().copied().collect::<Vec<_>>();
+    participants.sort_unstable();
+    let table = participants
+        .iter()
+        .map(|participant| {
+            let state = &states[participant];
+            format!(
+                "{}{}[avc_uuid={} mkm={} skm={} prekey={} published={} joined={}]",
+                participant,
+                if *participant == chosen { "*" } else { "" },
+                state.avc_uuid.is_some(),
+                state.mkm.len(),
+                state.skm.len(),
+                state.prekey.is_some(),
+                state.outgoing_key_material.is_some(),
+                joined.contains(participant),
+            )
+        })
+        .collect::<Vec<_>>()
+        .join(" ");
+    warn!(
+        "FaceTime control target: route={} chosen={} aliased={:?} participants={} | {}",
+        route_participant,
+        chosen,
+        aliases.get(&route_participant),
+        participants.len(),
+        table,
+    );
+}
