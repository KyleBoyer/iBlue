+    /// Re-advertise this participant's responder keys once the caller's VC
+    /// control channel proves that the incoming media leg is active. An early
+    /// command-211 can race the peer's join processing and be discarded even
+    /// though QuickRelay has already accepted the encrypted material.
+    pub async fn republish_outgoing_key_materials(
+        &self,
+        participant: u64,
+    ) -> Result<(), PushError> {
+        let Some((_, media_key_material, session_key_material)) = self
+            .outgoing_key_materials()
+            .await
+            .into_iter()
+            .find(|(candidate, _, _)| *candidate == participant)
+        else {
+            return Err(PushError::BadMsg);
+        };
+        let wire_message = FTWireMessage::responder_key_material(
+            self.group_id.clone(),
+            session_key_material,
+            media_key_material,
+            self.participant_handles().await,
+        );
+        let expires = SystemTime::now()
+            .checked_add(std::time::Duration::from_secs(605))
+            .ok_or(PushError::BadMsg)?
+            .duration_since(SystemTime::UNIX_EPOCH)
+            .map_err(|_| PushError::BadMsg)?
+            .as_secs();
+        self.message_participants(
+            Some(participant),
+            IDSSendMessage {
+                sender: self.handle.clone(),
+                raw: Raw::Body(plist_to_bin(&wire_message)?),
+                send_delivered: false,
+                command: 211,
+                no_response: false,
+                id: Uuid::new_v4().to_string().to_uppercase(),
+                scheduled_ms: None,
+                queue_id: None,
+                relay: None,
+                extras: Dictionary::from_iter([
+                    ("siu", Value::Boolean(false)),
+                    ("eX", Value::Integer(expires.into())),
+                ]),
+            },
+        )
+        .await
+    }
